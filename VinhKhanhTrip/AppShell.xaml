<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VinhKhanhTrip.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VinhKhanhTrip"
    Shell.FlyoutBehavior="Disabled"
    Title="VinhKhanhTrip">

    <TabBar>
        <Tab Title="Bản đồ" Icon="map.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="Danh sách" Icon="list.png">
            <ShellContent ContentTemplate="{DataTemplate local:DanhSachPage}" />
        </Tab>
        <Tab Title="Cài đặt" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate local:CaiDatPage}" />
        </Tab>
    </TabBar>
</Shell>