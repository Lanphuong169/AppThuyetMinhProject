<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTrip.CaiDatPage"
             Title="Cài Đặt"
             BackgroundColor="#F2F2F6">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Label Text="Tùy chỉnh hệ thống" FontAttributes="Bold" FontSize="18" TextColor="Gray"/>
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="🔊 Thuyết minh tự động" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="True"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EEEEEE"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="📍 Hiển thị Geofence" VerticalOptions="Center" TextColor="Black"/>
                        <Switch Grid.Column="1" IsToggled="True"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Ngôn ngữ / Language" FontAttributes="Bold" FontSize="18" TextColor="Gray" Margin="0,10,0,0"/>
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="5">
                <VerticalStackLayout>
                    <Button Text="🇻🇳 Tiếng Việt" Clicked="OnVietnameseClicked" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start"/>
                    <BoxView HeightRequest="1" Color="#EEEEEE"/>
                    <Button Text="🇬🇧 English" Clicked="OnEnglishClicked" BackgroundColor="Transparent" TextColor="Black" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>