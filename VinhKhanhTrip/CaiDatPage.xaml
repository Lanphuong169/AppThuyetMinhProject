<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTrip.CaiDatPage"
             Title="Cài Đặt"
             BackgroundColor="#080808">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="25">
            <Label x:Name="lblPageTitle" Text="CÀI ĐẶT HỆ THỐNG" TextColor="#C99446" FontAttributes="Bold" FontSize="14" CharacterSpacing="2" HorizontalOptions="Center" Margin="0,20,0,10"/>

            <Label x:Name="lblFeature" Text="Tính năng" FontAttributes="Bold" FontSize="16" TextColor="#E2C792"/>
            <Border BackgroundColor="#1A1A1A" Stroke="#C99446" StrokeThickness="0.5" StrokeShape="RoundRectangle 15" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="lblTts" Text="🔊 Thuyết minh tự động" TextColor="White" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="True" ThumbColor="#C99446" OnColor="#33C99446"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="#33C99446"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="lblGeofence" Text="📍 Hiển thị vùng Geofence" TextColor="White" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="True" ThumbColor="#C99446" OnColor="#33C99446"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="lblLanguage" Text="Ngôn ngữ" FontAttributes="Bold" FontSize="16" TextColor="#E2C792"/>
            <Border BackgroundColor="#1A1A1A" Stroke="#C99446" StrokeThickness="0.5" StrokeShape="RoundRectangle 15" Padding="5">
                <VerticalStackLayout>
                    <Button Text="🇻🇳 Tiếng Việt" Clicked="OnVietnameseClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇩🇪 Deutsch" Clicked="OnGermanClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇫🇷 Français" Clicked="OnFrenchClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇷🇺 Русский" Clicked="OnRussianClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇯🇵 日本語" Clicked="OnJapaneseClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇰🇷 한국어" Clicked="OnKoreanClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                    <BoxView HeightRequest="0.5" Color="#33C99446" Margin="15,0"/>

                    <Button Text="🇨🇳 中文" Clicked="OnChineseClicked" TextColor="White" BackgroundColor="Transparent" HorizontalOptions="Fill" ContentLayout="Left, 20"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>