<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTrip.DanhSachPage"
             Title="Danh Sách Quán Ăn"
             BackgroundColor="#F2F2F6">

    <CollectionView x:Name="danhSachQuanCollectionView" SelectionMode="Single" SelectionChanged="OnQuanAnSelected" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,5,0,10" BackgroundColor="White" StrokeShape="RoundRectangle 15">
                    <Grid ColumnDefinitions="120, *" Padding="10">
                        <Image Grid.Column="0" Source="{Binding DanhSachHinhAnh[0]}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5" Margin="15,0,0,0">
                            <Label Text="{Binding Ten}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                            <Label Text="{Binding MonDacSan}" TextColor="Red" FontSize="14" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>