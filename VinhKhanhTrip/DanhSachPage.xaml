<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTrip.DanhSachPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0D11">

    <Grid RowDefinitions="Auto, Auto, Auto, *" HorizontalOptions="Fill">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="15,20,15,10" ColumnSpacing="15">
            <Border BackgroundColor="#D4AF37" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                <Label Text="V/K" TextColor="#0D0D11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="VĨNH KHÁNH STREET" TextColor="#D4AF37" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
        </Grid>

        <Border Grid.Row="1" Margin="15,5,15,15" BackgroundColor="#1A1A22" Stroke="#2A2A35" StrokeShape="RoundRectangle 12" HeightRequest="48">
            <SearchBar x:Name="searchBar" Placeholder="Tìm quán ăn..." TextColor="White" TextChanged="OnSearchTextChanged" BackgroundColor="Transparent"/>
        </Border>

        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="15,0,0,15">
            <HorizontalStackLayout Spacing="10">
                <Border x:Name="BtnAll" BackgroundColor="#D4AF37" StrokeShape="RoundRectangle 18" Padding="18,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="All" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblAll" Text="Tất cả" TextColor="#0D0D11" FontAttributes="Bold"/>
                </Border>

                <Border x:Name="BtnOc" BackgroundColor="#1A1A22" Stroke="#2A2A35" StrokeShape="RoundRectangle 18" Padding="18,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Oc" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblOc" Text="Ốc &amp; Hải sản" TextColor="#AAAAAA"/>
                </Border>

                <Border x:Name="BtnLau" BackgroundColor="#1A1A22" Stroke="#2A2A35" StrokeShape="RoundRectangle 18" Padding="18,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Lau" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLau" Text="Lẩu &amp; Nướng" TextColor="#AAAAAA"/>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="3" x:Name="DanhSachCV" SelectionMode="Single" SelectionChanged="OnItemSelected" Margin="15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1A1A22" Stroke="#2A2A35" StrokeShape="RoundRectangle 16" Margin="0,0,0,15" Padding="10">
                        <VerticalStackLayout Spacing="5">
                            <Image Source="{Binding ImageUrl}" HeightRequest="150" Aspect="AspectFill" />
                            <Label Text="{Binding Ten}" FontAttributes="Bold" TextColor="#D4AF37" FontSize="16"/>
                            <Label Text="{Binding MoTa}" TextColor="#AAAAAA" FontSize="12" MaxLines="2"/>

                            <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Margin="0,10,0,0">
                                <Button Text="Bản đồ" Clicked="OnMapButtonClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#D4AF37" BorderColor="#D4AF37" BorderWidth="1" HeightRequest="35" FontSize="11"/>
                                <Button Text="Nghe" Clicked="OnSpeakerButtonClicked" CommandParameter="{Binding .}" BackgroundColor="#D4AF37" TextColor="#0D0D11" HeightRequest="35" FontSize="11"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>