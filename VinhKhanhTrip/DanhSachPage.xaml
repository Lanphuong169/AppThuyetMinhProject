<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VinhKhanhTrip.Models"
             x:Class="VinhKhanhTrip.DanhSachPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080808">

    <Grid RowDefinitions="Auto, Auto, Auto, *" HorizontalOptions="Fill">

        <Image Grid.Row="0" 
               Source="logo_vinhkhanh.png" 
               HorizontalOptions="Fill" 
               VerticalOptions="Start"
               Aspect="AspectFill"
               HeightRequest="160"
               Margin="0,0,0,15" />

        <Border Grid.Row="1" Margin="15,0,15,15" BackgroundColor="#1A1A1A" Stroke="#C99446" StrokeThickness="1" StrokeShape="RoundRectangle 20" HeightRequest="45">
            <SearchBar x:Name="searchBar" x:DataType="SearchBar" Placeholder="Tìm kiếm nhà hàng..." PlaceholderColor="#AAAAAA" TextColor="White" TextChanged="OnSearchTextChanged" BackgroundColor="Transparent"/>
        </Border>

        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="15,0,0,15">
            <HorizontalStackLayout Spacing="10">
                <Border x:Name="BtnAll" BackgroundColor="#C99446" Stroke="#C99446" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="All" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblAll" Text="Tất cả" TextColor="#000000" FontAttributes="Bold"/>
                </Border>

                <Border x:Name="BtnOc" BackgroundColor="Transparent" Stroke="#C99446" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Oc" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblOc" Text="Ốc &amp; Hải sản" TextColor="#C99446"/>
                </Border>

                <Border x:Name="BtnLau" BackgroundColor="Transparent" Stroke="#C99446" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Lau" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLau" Text="Lẩu &amp; Nướng" TextColor="#C99446"/>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="3" x:Name="DanhSachCV" SelectionMode="Single" SelectionChanged="OnItemSelected" Margin="15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:QuanAn">
                    <Border BackgroundColor="#080808" Stroke="#C99446" StrokeThickness="1" StrokeShape="RoundRectangle 16" Margin="0,0,0,20" Padding="15">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="8">

                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Ten}" FontAttributes="Bold" TextColor="#C99446" FontSize="18" Grid.Column="0" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Text="★" TextColor="#C99446" FontSize="16"/>
                                    <Label Text="{Binding Rating}" TextColor="#C99446" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="{Binding DiaChi}" TextColor="#E2C792" FontSize="12"/>
                                <Label Text="{Binding OpeningHours}" TextColor="#E2C792" FontSize="12"/>
                            </VerticalStackLayout>

                            <Grid Grid.Row="2" ColumnDefinitions="2*, 1*" ColumnSpacing="8" HeightRequest="160" Margin="0,5,0,0">
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="*, *" RowSpacing="8">
                                    <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent">
                                        <Image Source="{Binding ImageUrl2}" Aspect="AspectFill" />
                                    </Border>
                                    <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent">
                                        <Image Source="{Binding ImageUrl3}" Aspect="AspectFill" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <Label Grid.Row="3" Text="{Binding MoTaHienThi}" TextColor="#AAAAAA" FontSize="13" LineHeight="1.2" Margin="0,5,0,0" MaxLines="2"/>

                            <Grid Grid.Row="4" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="90, *" RowSpacing="8" Margin="0,10,0,10">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding LblMonAn}" TextColor="#E2C792" FontSize="13" VerticalOptions="Center"/>
                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#C99446" StrokeShape="RoundRectangle 12" HeightRequest="24" HorizontalOptions="Fill">
                                    <Label Text="{Binding Rating, StringFormat='{0} ★'}" TextColor="#000000" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding LblPhucVu}" TextColor="#E2C792" FontSize="13" VerticalOptions="Center"/>
                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#C99446" StrokeShape="RoundRectangle 12" HeightRequest="24" HorizontalOptions="Fill">
                                    <Label Text="92%" TextColor="#000000" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding LblKhongGian}" TextColor="#E2C792" FontSize="13" VerticalOptions="Center"/>
                                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#C99446" StrokeShape="RoundRectangle 12" HeightRequest="24" HorizontalOptions="Fill">
                                    <Label Text="80%" TextColor="#000000" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="5" ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="{Binding BtnXemChiTiet}" Clicked="OnMapButtonClicked" CommandParameter="{Binding .}" BackgroundColor="#C99446" TextColor="#000000" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" FontSize="13"/>
                                <Button Grid.Column="1" Text="{Binding BtnThuyetMinh}" Clicked="OnSpeakerButtonClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderColor="#C99446" BorderWidth="1" TextColor="#C99446" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" FontSize="13"/>
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>