<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTrip.QuanAnDetailPage"
             BackgroundColor="#F2F2F6">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="{Binding Ten}" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblTitleDescription" FontAttributes="Bold" FontSize="18" TextColor="#4285F4"/>
                    <Label x:Name="lblMoTa" Text="{Binding MoTa}" TextColor="Black" FontSize="16"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblTitleSpecialties" FontAttributes="Bold" FontSize="18" TextColor="#4285F4"/>
                    <Label Text="Món ăn đặc sản của quán..." TextColor="Black" FontSize="16"/>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="btnViewMap" Clicked="OnBackButtonClicked" BackgroundColor="#4285F4" TextColor="White" CornerRadius="25" HeightRequest="50" Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>